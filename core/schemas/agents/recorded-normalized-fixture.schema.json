{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/agents/recorded-normalized-fixture.schema.json",
  "title": "K-DLC recorded normalized test fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "source_id", "source_hash", "media_type", "units"],
  "properties": {
    "api_version": {"const": "kdlc.dev/recorded-normalized-fixture/v1alpha1"},
    "source_id": {"type": "string", "pattern": "^src_[a-z0-9]+$"},
    "source_hash": {"$ref": "../common.schema.json#/$defs/digest"},
    "media_type": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["locator", "text"],
        "properties": {"locator": {"type": "object", "minProperties": 1}, "text": {"$ref": "../common.schema.json#/$defs/nonEmptyString"}}
      }
    }
  }
}
