{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/lifecycle/checkpoint-1.json",
  "type": "object",
  "required": ["version", "workflow_id", "stage", "stage_version", "attempt_id", "project_version", "dependency_versions", "input_hashes", "output_hashes", "policy_versions", "profile_versions", "project_hash", "dependency_hashes", "policy_hashes", "profile_hashes", "tool_hashes", "settings_hash", "attempt_history", "agent", "sensors", "approval_receipts", "deterministic", "completed_at"],
  "properties": {
    "version": {"const": 1}, "workflow_id": {"type": "string"}, "stage": {"type": "string"},
    "stage_version": {"type": "integer", "minimum": 1}, "attempt_id": {"type": "string"},
    "project_version": {"type": "string"}, "dependency_versions": {"type": "object"},
    "input_hashes": {"type": "object"}, "output_hashes": {"type": "object"},
    "policy_versions": {"type": "array", "items": {"type": "string"}},
    "profile_versions": {"type": "array", "items": {"type": "string"}},
    "project_hash": {"type": ["string", "null"]},
    "dependency_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "policy_hashes": {"type": "array", "items": {"type": "string"}},
    "profile_hashes": {"type": "array", "items": {"type": "string"}},
    "tool_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "settings_hash": {"type": ["string", "null"]},
    "supersedes_attempt_id": {"type": "string"},
    "attempt_history": {"type": "array", "items": {"type": "object"}},
    "agent": {"type": "object"}, "model": {"type": ["object", "null"]},
    "sensors": {"type": "array"}, "approval_receipts": {"type": "array", "items": {"type": "string"}},
    "deterministic": {"type": "boolean"}, "completed_at": {"type": "string", "format": "date-time"},
    "audit_pending": {
      "type": "object",
      "required": ["actor", "action", "result", "idempotency_key"],
      "properties": {
        "project": {"type": "string"}, "stage": {"type": "string"}, "actor": {"type": "string"},
        "action": {"const": "stage.completed"}, "input_hash": {"type": "string"},
        "result": {"const": "completed"}, "idempotency_key": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "invalidated_at": {"type": "string", "format": "date-time"}, "invalidation_reason": {"type": "string"}
  },
  "additionalProperties": false
}
