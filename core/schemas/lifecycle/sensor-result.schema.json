{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/lifecycle/sensor-result-1.json",
  "type": "object",
  "required": ["sensor_id", "version", "blocking", "status"],
  "properties": {
    "sensor_id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "blocking": {"type": "boolean"},
    "status": {"enum": ["passed", "failed", "warning", "error"]}, "blocks": {"type": "boolean"},
    "finding": {},
    "waiver": {
      "type": "object",
      "required": ["id", "authority", "reason", "expires_at"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "additionalProperties": true
}
