{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/extensions/sensor.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "kind", "id", "version", "stage_ids", "severity", "blocking", "deterministic"],
  "properties": {
    "api_version": {"const": "kdlc.dev/sensor-extension/v1alpha1"}, "kind": {"const": "Sensor"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "stage_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "severity": {"enum": ["info", "warning", "error"]}, "blocking": {"type": "boolean"}, "deterministic": {"const": true},
    "executable_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}, "config_schema": {"type": "object"}
  }
}
