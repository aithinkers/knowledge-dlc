{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/extensions/migration.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "id", "plugin", "from", "to", "reversible", "operations"],
  "properties": {
    "api_version": {"const": "kdlc.dev/migration/v1alpha1"}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}, "plugin": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "from": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}, "to": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}, "reversible": {"type": "boolean"},
    "operations": {"type": "array", "minItems": 1, "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "from", "to", "semantic_effect"], "properties": {"kind": {"const": "rename"}, "from": {"$ref": "#/$defs/path"}, "to": {"$ref": "#/$defs/path"}, "semantic_effect": {"$ref": "#/$defs/effect"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "path", "pointer", "before", "after", "semantic_effect"], "properties": {"kind": {"const": "replace-json"}, "path": {"$ref": "#/$defs/path"}, "pointer": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$"}, "before": true, "after": true, "semantic_effect": {"$ref": "#/$defs/effect"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "path", "pointer", "before", "after", "semantic_effect"], "properties": {"kind": {"const": "merge-json"}, "path": {"$ref": "#/$defs/path"}, "pointer": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$"}, "before": {"type": "object"}, "after": {"type": "object"}, "semantic_effect": {"$ref": "#/$defs/effect"}}}
    ]}}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"},
    "effect": {"type": "object", "additionalProperties": false, "required": ["category", "description"], "properties": {"category": {"enum": ["none", "content", "validation", "trust", "routing", "permission"]}, "description": {"type": "string", "minLength": 1}}}
  }
}
