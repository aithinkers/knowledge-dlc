{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/extensions/profile.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "extends", "rules", "security"],
  "properties": {
    "api_version": {"const": "kdlc.dev/profile/v1alpha1"}, "kind": {"const": "Profile"},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}}},
    "extends": {"type": ["string", "null"]},
    "rules": {"type": "object"},
    "security": {"type": "object", "additionalProperties": false, "required": ["minimum_trust", "approval_gates"], "properties": {"minimum_trust": {"enum": ["unverified", "machine-confirmed", "human-reviewed"]}, "approval_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  }
}
