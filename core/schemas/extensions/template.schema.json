{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/extensions/template.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "files"],
  "properties": {
    "api_version": {"const": "kdlc.dev/template/v1alpha1"}, "kind": {"const": "Template"},
    "metadata": {"$ref": "#/$defs/identity"},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "source", "merge"], "properties": {"path": {"$ref": "#/$defs/path"}, "source": {"$ref": "#/$defs/path"}, "merge": {"enum": ["create", "replace", "deep-merge"]}}}}
  },
  "$defs": {
    "identity": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}}},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"}
  }
}
