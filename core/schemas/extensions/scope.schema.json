{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/extensions/scope.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "stages", "approval_gates"],
  "properties": {
    "api_version": {"const": "kdlc.dev/scope/v1alpha1"}, "kind": {"const": "Scope"},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}}},
    "stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "approval_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "settings": {"type": "object"}
  }
}
