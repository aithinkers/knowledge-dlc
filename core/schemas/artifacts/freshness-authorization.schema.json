{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/artifacts/freshness-authorization.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "subject", "field", "value_hash", "packet_hash", "policy", "authorized_by", "authorized_at"],
  "properties": {
    "api_version": {"const": "kdlc.dev/freshness-authorization/v1alpha1"},
    "subject": {"type": "string", "pattern": "^kb://[^/]+/.+$"},
    "field": {"const": "stale_after"},
    "value_hash": {"$ref": "../common.schema.json#/$defs/digest"},
    "packet_hash": {"$ref": "../common.schema.json#/$defs/digest"},
    "policy": {"$ref": "../common.schema.json#/$defs/versionedHash"},
    "authorized_by": {"$ref": "../common.schema.json#/$defs/actor"},
    "authorized_at": {"$ref": "../common.schema.json#/$defs/dateTime"}
  }
}
