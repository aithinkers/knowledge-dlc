{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/artifacts/freshness-decision.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "proposal_id", "packet_hash", "authorization_hash", "value_hash", "policy", "authorized_by", "activated_at"],
  "properties": {
    "api_version": {"const": "kdlc.dev/freshness-decision/v1alpha1"},
    "proposal_id": {"type": "string", "pattern": "^pr_[a-z0-9]+$"},
    "packet_hash": {"$ref": "../common.schema.json#/$defs/digest"},
    "authorization_hash": {"$ref": "../common.schema.json#/$defs/digest"},
    "value_hash": {"$ref": "../common.schema.json#/$defs/digest"},
    "policy": {"$ref": "../common.schema.json#/$defs/versionedHash"},
    "authorized_by": {"$ref": "../common.schema.json#/$defs/actor"},
    "activated_at": {"$ref": "../common.schema.json#/$defs/dateTime"}
  }
}
