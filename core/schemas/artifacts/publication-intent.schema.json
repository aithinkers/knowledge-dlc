{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/artifacts/publication-intent.schema.json",
  "title": "K-DLC authorized publication intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "workflow_id", "proposal_id", "receipt_id", "packet_hash", "review_hash", "subject", "prepared_at"],
  "properties": {
    "api_version": {"const": "kdlc.dev/publication-intent/v1alpha1"},
    "workflow_id": {"type": "string", "pattern": "^wf_[a-z0-9]+$"},
    "proposal_id": {"type": "string", "pattern": "^pr_[a-z0-9]+$"},
    "receipt_id": {"type": "string", "pattern": "^rr_[a-z0-9]+$"},
    "packet_hash": {"$ref": "../common.schema.json#/$defs/digest"},
    "review_hash": {"$ref": "../common.schema.json#/$defs/digest"},
    "subject": {"type": "string", "pattern": "^kb://[^/]+/.+$"},
    "prepared_at": {"$ref": "../common.schema.json#/$defs/dateTime"}
  }
}
