{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/artifacts/claim.schema.json",
  "title": "K-DLC workflow claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "text", "source_id", "source_hash", "extraction", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^clm_[a-z0-9]+$"},
    "text": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
    "source_id": {"type": "string", "pattern": "^src_[a-z0-9]+$"},
    "source_hash": {"$ref": "../common.schema.json#/$defs/digest"},
    "locator": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          {"type": "string", "minLength": 1},
          {"type": "integer", "minimum": 0},
          {"type": "number"},
          {"type": "array", "items": {"anyOf": [{"type": "string"}, {"type": "number"}]}}
        ]
      }
    },
    "extraction": {"enum": ["explicit", "inferred", "computed"]},
    "applicability": {"type": "object", "minProperties": 1, "additionalProperties": true},
    "status": {"enum": ["candidate", "accepted", "rejected", "merged", "superseded", "conflict"]}
  }
}
