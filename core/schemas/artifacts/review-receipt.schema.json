{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/artifacts/review-receipt.schema.json",
  "title": "K-DLC review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "id", "proposal_id", "subject", "decision", "reviewer", "review", "packet_hash", "source_hashes", "resolved_dependencies", "profile", "policies", "reviewed_at"],
  "properties": {
    "api_version": {"const": "kdlc.dev/review-receipt/v1alpha1"},
    "id": {"type": "string", "pattern": "^rr_[a-z0-9]+$"},
    "proposal_id": {"type": "string", "pattern": "^pr_[a-z0-9]+$"},
    "subject": {"type": "string", "pattern": "^kb://[^/]+/.+$"},
    "decision": {"enum": ["approved", "rejected", "changes-requested"]},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "principal_mode"],
      "properties": {
        "actor": {"$ref": "../common.schema.json#/$defs/actor"},
        "principal_mode": {"enum": ["local", "served", "automation"]},
        "issuer": {"$ref": "../common.schema.json#/$defs/resource"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "projection", "hash", "fields"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization": {"const": "kdlc-c14n-1"},
        "projection": {"const": "kdlc-review-1"},
        "hash": {"$ref": "../common.schema.json#/$defs/digest"},
        "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "../common.schema.json#/$defs/nonEmptyString"}}
      }
    },
    "packet_hash": {"$ref": "../common.schema.json#/$defs/digest"},
    "source_hashes": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common.schema.json#/$defs/digest"}},
    "resolved_dependencies": {
      "type": "object",
      "propertyNames": {"$ref": "../common.schema.json#/$defs/knowledgeBaseId"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "tree_hash"],
        "properties": {"version": {"$ref": "../common.schema.json#/$defs/nonEmptyString"}, "tree_hash": {"$ref": "../common.schema.json#/$defs/digest"}}
      }
    },
    "profile": {"$ref": "../common.schema.json#/$defs/versionedHash"},
    "policies": {"type": "array", "items": {"$ref": "../common.schema.json#/$defs/versionedHash"}},
    "reviewed_at": {"$ref": "../common.schema.json#/$defs/dateTime"}
  }
}
