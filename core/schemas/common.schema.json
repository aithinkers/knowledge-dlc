{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/common.schema.json",
  "title": "K-DLC common contract definitions",
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "dnsName": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
    },
    "knowledgeBaseId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "dateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "duration": {"type": "string", "pattern": "^[1-9][0-9]*(?:d|h|m|s)$"},
    "actor": {
      "type": "string",
      "pattern": "^(?:human:[A-Za-z0-9._@/-]+|process:[A-Za-z0-9._@/-]+|[a-z][a-z0-9_-]*/[^/\\s]+)$"
    },
    "resource": {"type": "string", "minLength": 1},
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "compactIdentifier": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification"],
      "properties": {
        "classification": {"$ref": "#/$defs/classification"},
        "compartments": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "policy_ref": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "versionedHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/nonEmptyString"},
        "hash": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
