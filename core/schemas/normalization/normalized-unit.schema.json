{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/normalization/normalized-unit-1.json",
  "type": "object",
  "required": ["unit_id", "kind", "order", "locator", "source_hash", "extraction_method", "quality_warnings"],
  "properties": {
    "unit_id": {"type": "string", "pattern": "^unit_[a-f0-9]{16}$"}, "kind": {"type": "string", "minLength": 1},
    "parent_id": {"type": ["string", "null"]}, "order": {"type": "integer", "minimum": 0},
    "text": {"type": "string"}, "structured_data": {},
    "locator": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["line-range", "heading", "row", "cell", "range", "page", "page-bbox", "part-paragraph", "part-table", "sheet-cell", "sheet-range", "slide", "slide-shape", "diagram-cell", "frame", "time-range", "visio-page", "visio-shape"]}, "page":{}, "frame":{}, "part":{}, "sheet":{}, "start_line":{}, "end_line":{}, "heading":{}, "line":{}}, "allOf": [
      {"if":{"properties":{"kind":{"enum":["page","page-bbox","slide","slide-shape","diagram-cell","visio-page","visio-shape"]}}},"then":{"properties":{"page":{}},"required":["page"]}},
      {"if":{"properties":{"kind":{"enum":["frame","time-range"]}}},"then":{"properties":{"frame":{}},"required":["frame"]}},
      {"if":{"properties":{"kind":{"enum":["part-paragraph","part-table"]}}},"then":{"properties":{"part":{}},"required":["part"]}},
      {"if":{"properties":{"kind":{"enum":["sheet-cell","sheet-range"]}}},"then":{"properties":{"sheet":{}},"required":["sheet"]}},
      {"if":{"properties":{"kind":{"const":"line-range"}}},"then":{"properties":{"start_line":{},"end_line":{}},"required":["start_line","end_line"]}},
      {"if":{"properties":{"kind":{"const":"heading"}}},"then":{"properties":{"heading":{},"line":{}},"required":["heading","line"]}}
    ], "additionalProperties": true},
    "source_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "extraction_method": {"type": "object", "required": ["mode", "normalizer", "version"], "properties": {"mode": {"enum": ["deterministic", "probabilistic"]}, "normalizer": {"type": "string"}, "version": {"type": "string"}, "model": {"type": "object", "required":["id","version","provider","recorded_output_hash"], "properties":{"id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},"recorded_output_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},"additionalProperties":false}}, "additionalProperties": false},
    "language": {"type": "string"}, "quality_warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "anyOf": [{"properties": {"text": {}}, "required": ["text"]}, {"properties": {"structured_data": {}}, "required": ["structured_data"]}],
  "allOf": [{"if":{"properties":{"extraction_method":{"type":"object","properties":{"mode":{"const":"probabilistic"}},"required":["mode"]}}},"then":{"properties":{"extraction_method":{"type":"object","properties":{"model":{}},"required":["model"]}}}}],
  "additionalProperties": false
}
