{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/release/statistical-profile-1.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "id", "version", "corpus_hash", "evaluator_gold_hash", "manifest_hashes", "scorer", "required_trials", "confidence", "wilson_z", "minimum_case_wilson_lower_bound", "interpretation", "exclusions", "metrics"],
  "properties": {
    "api_version": {"const": "kdlc.dev/statistical-profile/v1alpha1"}, "id": {"const": "kdlc-mvp-quality"}, "version": {"const": 1},
    "corpus_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"},
    "evaluator_gold_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"},
    "manifest_hashes": {"type": "object", "additionalProperties": false, "required": ["prompt", "tool", "model"], "properties": {"prompt": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}, "tool": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}, "model": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}}},
    "scorer": {"type": "object", "additionalProperties": false, "required": ["id", "version", "path", "sha256"], "properties": {"id": {"const": "kdlc-offline-statistical-scorer"}, "version": {"const": 2}, "path": {"const": "scripts/statistical-evidence-validation.mjs"}, "sha256": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}}},
    "required_trials": {"const": 30}, "confidence": {"const": 0.95}, "wilson_z": {"const": 1.959963984540054}, "minimum_case_wilson_lower_bound": {"const": 0.85},
    "interpretation": {"const": "repeated-provider-call operational reliability on this frozen corpus; not content-generalization evidence"},
    "exclusions": {"type": "object", "additionalProperties": false, "required": ["allowed", "post_hoc"], "properties": {"allowed": {"const": false}, "post_hoc": {"const": false}}},
    "metrics": {"type": "array", "prefixItems": [
      {"type":"object","additionalProperties":false,"required":["id","minimum_wilson_lower_bound"],"properties":{"id":{"const":"decision_accuracy"},"minimum_wilson_lower_bound":{"type":"number","exclusiveMinimum":0,"maximum":1}}},
      {"type":"object","additionalProperties":false,"required":["id","minimum_wilson_lower_bound"],"properties":{"id":{"const":"grounded_fact_accuracy"},"minimum_wilson_lower_bound":{"type":"number","exclusiveMinimum":0,"maximum":1}}},
      {"type":"object","additionalProperties":false,"required":["id","minimum_wilson_lower_bound"],"properties":{"id":{"const":"locator_accuracy"},"minimum_wilson_lower_bound":{"type":"number","exclusiveMinimum":0,"maximum":1}}},
      {"type":"object","additionalProperties":false,"required":["id","minimum_success_rate"],"properties":{"id":{"const":"security_fail_closed"},"minimum_success_rate":{"const":1}}}
    ],"items":false,"minItems":4,"maxItems":4}
  }
}
