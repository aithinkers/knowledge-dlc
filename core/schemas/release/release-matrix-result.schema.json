{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://kdlc.dev/schemas/release/release-matrix-result-1.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "cell", "runtime", "platform", "commands", "differences"],
  "properties": {
    "api_version": {"const": "kdlc.dev/release-matrix-result/v1alpha1"}, "cell": {"type": "string", "pattern": "^(?:ubuntu|windows|macos)-node(?:22|24)$"},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["node", "npm"], "properties": {"node": {"enum": ["22.23.2", "24.5.0"]}, "npm": {"const": "11.5.1"}}},
    "platform": {"type": "object", "additionalProperties": false, "required": ["os", "arch"], "properties": {"os": {"enum": ["linux", "win32", "darwin"]}, "arch": {"type": "string", "minLength": 1}}},
    "commands": {"type": "array", "minItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {"id": {"enum": ["full", "offline", "release", "statistical", "clean-rebuild", "pack", "cli", "import"]}, "status": {"const": "passed"}}}},
    "differences": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"type": "string"}, "value": {"type": "string"}}}}
  }
}
