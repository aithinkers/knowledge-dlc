{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://kdlc.dev/schemas/release/release-matrix-result-1.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "cell", "head_sha", "runtime", "platform", "commands", "differences", "observed_evidence"],
  "properties": {
    "api_version": {"const": "kdlc.dev/release-matrix-result/v1alpha1"}, "cell": {"type": "string", "pattern": "^(?:ubuntu|windows|macos)-node(?:22|24)$"}, "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["node", "npm"], "properties": {"node": {"enum": ["22.23.2", "24.5.0"]}, "npm": {"const": "11.5.1"}}},
    "platform": {"type": "object", "additionalProperties": false, "required": ["os", "arch"], "properties": {"os": {"enum": ["linux", "win32", "darwin"]}, "arch": {"type": "string", "minLength": 1}}},
    "commands": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {"id": {"enum": ["full", "offline", "release", "statistical", "clean-rebuild", "supply-chain", "pack", "cli", "import"]}, "status": {"const": "passed"}}}},
    "differences": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"enum": ["path_separator", "line_ending", "executable_shim"]}, "value": {"enum": ["slash", "backslash", "lf-generated-evidence", "posix", "cmd"]}}}},
    "observed_evidence": {"type": "object", "additionalProperties": false, "required": ["package", "supply_chain", "smoke"], "properties": {
      "package": {"type": "object", "additionalProperties": false, "required": ["first_sha256", "second_sha256", "manifest_sha256", "file_count"], "properties": {"first_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "second_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "file_count": {"type": "integer", "minimum": 1}}},
      "supply_chain": {"type": "object", "additionalProperties": false, "required": ["sbom_sha256", "notices_sha256"], "properties": {"sbom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "notices_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      "smoke": {"type": "object", "additionalProperties": false, "required": ["cli", "imports"], "properties": {"cli": {"const": true}, "imports": {"const": true}}}
    }}
  }
}
