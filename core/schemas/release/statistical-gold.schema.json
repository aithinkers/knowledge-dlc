{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://kdlc.dev/schemas/release/statistical-gold-1.json",
  "$defs": {
    "assertion": {"type": "object", "additionalProperties": false, "required": ["subject", "predicate", "object"], "properties": {"subject": {"type": "string", "minLength": 1}, "predicate": {"type": "string", "minLength": 1}, "object": {"type": "string", "minLength": 1}}},
    "citation": {"type": "object", "additionalProperties": false, "required": ["source_id", "locator"], "properties": {"source_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}, "locator": {"$ref": "https://kdlc.dev/schemas/release/statistical-corpus-1.json#/$defs/locator"}}}
  },
  "type": "object", "additionalProperties": false, "required": ["api_version", "id", "version", "corpus_hash", "cases"],
  "properties": {
    "api_version": {"const": "kdlc.dev/statistical-gold/v1alpha1"}, "id": {"const": "kdlc-mvp-statistical-gold"}, "version": {"const": 1}, "corpus_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"},
    "cases": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["case_key", "category", "expected", "security_gate"], "properties": {
      "case_key": {"type": "string", "pattern": "^case-(?:00[1-9]|01[0-2])$"},
      "category": {"enum": ["source", "contradiction", "temporal", "ambiguity", "restriction", "prompt-injection", "falsehood", "format", "revocation", "multilingual-answer", "multilingual-restriction", "human-edit"]},
      "expected": {"type": "object", "additionalProperties": false, "required": ["decision", "assertions", "citations"], "properties": {"decision": {"enum": ["answer", "abstain", "deny", "conflict"]}, "assertions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/assertion"}}, "citations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/citation"}}}},
      "security_gate": {"type": "boolean"}
    }}}
  }
}
