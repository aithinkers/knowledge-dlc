{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/release/recorded-run-1.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "id", "corpus_hash", "profile_hash", "runtime", "external_network_calls", "live_model_calls", "results"],
  "properties": {
    "api_version": {"const": "kdlc.dev/recorded-release-run/v1alpha1"}, "id": {"const": "pre-release-recorded-1"},
    "corpus_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}, "profile_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["node", "npm"], "properties": {"node": {"const": "24.5.0"}, "npm": {"const": "11.5.1"}}},
    "external_network_calls": {"const": 0}, "live_model_calls": {"const": 0},
    "results": {
      "type": "array", "minItems": 8,
      "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "status", "observations", "evidence"], "properties": {"case_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}, "status": {"enum": ["passed", "failed"]}, "observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}
    }
  }
}
