{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://kdlc.dev/schemas/release/statistical-capture-1.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "trial_id", "captured_at", "corpus_hash", "evaluator_gold_hash", "profile_hash", "manifest_hashes", "results", "exclusions"],
  "properties": {
    "api_version": {"const": "kdlc.dev/statistical-capture/v1alpha1"}, "trial_id": {"type": "string", "pattern": "^trial-(?:00[1-9]|0[12][0-9]|030)$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "corpus_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}, "evaluator_gold_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}, "profile_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"},
    "manifest_hashes": {"type": "object", "additionalProperties": false, "required": ["prompt", "tool", "model"], "properties": {"prompt": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}, "tool": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}, "model": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}}},
    "results": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["case_key", "provider_request_id", "request", "request_hash", "response", "raw_output", "raw_output_hash"], "properties": {"case_key": {"type": "string", "pattern": "^case-(?:00[1-9]|01[0-2])$"}, "provider_request_id": {"type": "string", "minLength": 1}, "request": {"type": "string", "minLength": 1}, "request_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}, "response": {"$ref":"https://kdlc.dev/schemas/release/statistical-response-1.json"}, "raw_output": {"type": "string", "minLength": 1}, "raw_output_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}}}},
    "exclusions": {"const": []}
  }
}
