{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://kdlc.dev/schemas/release/statistical-report-1.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "release_status", "corpus_hash", "profile_hash", "capture_set_hash", "trial_count", "case_count_per_trial", "metrics", "gate"],
  "properties": {
    "api_version": {"const": "kdlc.dev/statistical-report/v1alpha1"}, "release_status": {"const": "not-ready"},
    "corpus_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}, "profile_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}, "capture_set_hash": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"},
    "trial_count": {"const": 30}, "case_count_per_trial": {"const": 12},
    "metrics": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["id", "successes", "observations", "rate", "wilson_lower_bound", "threshold", "passed"], "properties": {"id": {"enum": ["decision_accuracy", "required_term_recall", "security_fail_closed"]}, "successes": {"type": "integer", "minimum": 0}, "observations": {"type": "integer", "minimum": 1}, "rate": {"type": "number", "minimum": 0, "maximum": 1}, "wilson_lower_bound": {"type": "number", "minimum": 0, "maximum": 1}, "threshold": {"type": "number", "minimum": 0, "maximum": 1}, "passed": {"type": "boolean"}}}},
    "gate": {"enum": ["passed", "failed"]}
  }
}
