{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/release/evaluation-corpus-1.json",
  "type": "object", "additionalProperties": false,
  "required": ["api_version", "id", "version", "scope", "deterministic", "pending_categories", "cases"],
  "properties": {
    "api_version": {"const": "kdlc.dev/release-evaluation-corpus/v1alpha1"},
    "id": {"const": "kdlc-mvp-recorded"}, "version": {"const": 1}, "scope": {"const": "pre-release-structural-subset"}, "deterministic": {"const": true},
    "pending_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["revoked-source-erasure", "multilingual-quality", "human-reviewer-quality", "statistical-model-quality"]}},
    "cases": {
      "type": "array", "minItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "category", "requirement_ids", "fixtures", "expected", "security"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "category": {"enum": ["workflow", "normalization", "governance", "retrieval", "concurrency", "distribution", "rebuild", "security"]},
          "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:FEAT|REQ-[A-Z]+)-[0-9]{3}$"}},
          "fixtures": {
            "type": "array", "minItems": 1,
            "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?:tests|distribution|core)/[A-Za-z0-9._/-]+$"}, "sha256": {"$ref": "https://kdlc.dev/schemas/v1alpha1/common.schema.json#/$defs/digest"}}}
          },
          "expected": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "security": {"type": "boolean"}
        }
      }
    }
  }
}
