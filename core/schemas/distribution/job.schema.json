{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/distribution/job-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "id",
    "project_id",
    "workflow_id",
    "principal",
    "operation",
    "idempotency_key",
    "input_hashes",
    "dependencies",
    "state",
    "progress",
    "checkpoints",
    "resource_budget",
    "created_at",
    "updated_at",
    "result",
    "error",
    "cancellation_requested",
    "request",
    "revision",
    "attempts"
  ],
  "properties": {
    "api_version": { "const": "kdlc.dev/job/v1" },
    "id": { "type": "string", "pattern": "^job_[a-f0-9]{16}$" },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "workflow_id": { "type": ["string", "null"] },
    "principal": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["adopt", "ingest", "refresh"] },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128 },
    "input_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "dependencies": { "type": "object" },
    "state": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "parked"
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "total"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "checkpoints": { "type": "array" },
    "resource_budget": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "result": {},
    "error": {},
    "cancellation_requested": { "type": "boolean" },
    "request": { "type": "object" },
    "revision": { "type": "integer", "minimum": 0 },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lease_id",
          "process_id",
          "started_at",
          "state",
          "result_hash"
        ],
        "properties": {
          "lease_id": { "type": "string" },
          "process_id": { "type": "integer", "minimum": 1 },
          "started_at": { "type": "string", "format": "date-time" },
          "finished_at": { "type": "string", "format": "date-time" },
          "state": { "enum": ["running", "completed", "cancelled", "failed"] },
          "result_hash": {
            "type": ["string", "null"],
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
