{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/manifests/knowledge-base.schema.json",
  "title": "K-DLC KnowledgeBase manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "format", "profile", "ownership", "access", "publication"],
  "properties": {
    "api_version": {"const": "kdlc.dev/v1alpha1"},
    "kind": {"const": "KnowledgeBase"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "title", "version"],
      "properties": {
        "id": {"$ref": "../common.schema.json#/$defs/knowledgeBaseId"},
        "name": {"$ref": "../common.schema.json#/$defs/dnsName"},
        "title": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
        "version": {"$ref": "../common.schema.json#/$defs/nonEmptyString"}
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version"],
      "properties": {"type": {"const": "okf"}, "version": {"const": "0.2"}}
    },
    "profile": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "maintainers"],
      "properties": {
        "owner": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
        "maintainers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "../common.schema.json#/$defs/nonEmptyString"}}
      }
    },
    "access": {"$ref": "../common.schema.json#/$defs/access"},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_requires", "default_stale_after"],
      "properties": {
        "stable_requires": {
          "type": "object",
          "additionalProperties": false,
          "required": ["human_verifiers"],
          "properties": {"human_verifiers": {"type": "integer", "minimum": 0}}
        },
        "default_stale_after": {"$ref": "../common.schema.json#/$defs/duration"}
      }
    }
  }
}
