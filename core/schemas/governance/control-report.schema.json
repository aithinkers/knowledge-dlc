{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdlc.dev/schemas/v1alpha1/governance/control-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "gate", "subject", "policy_hash", "evaluated_at", "results", "allowed", "report_hash"],
  "properties": {
    "api_version": {"const": "kdlc.dev/governance-control-report/v1alpha1"},
    "gate": {"enum": ["ingest", "review", "retrieval", "model-route", "publication", "erasure"]},
    "subject": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
    "policy_hash": {"$ref": "../common.schema.json#/$defs/digest"},
    "evaluated_at": {"$ref": "../common.schema.json#/$defs/dateTime"},
    "allowed": {"type": "boolean"},
    "report_hash": {"$ref": "../common.schema.json#/$defs/digest"},
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "gate", "severity", "result", "blocks", "finding_codes", "producer", "execution_hash"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "version": {"type": "integer", "minimum": 1},
          "gate": {"enum": ["ingest", "review", "retrieval", "model-route", "publication", "erasure"]},
          "severity": {"enum": ["info", "warning", "error"]},
          "result": {"enum": ["passed", "failed", "waived"]},
          "blocks": {"type": "boolean"},
          "finding_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^KDLC_[A-Z0-9_]+$"}},
          "producer": {"const": "kdlc-governance-runtime/1"},
          "execution_hash": {"$ref": "../common.schema.json#/$defs/digest"},
          "waiver": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "authority", "reason", "expires_at"],
            "properties": {
              "id": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
              "authority": {"$ref": "../common.schema.json#/$defs/actor"},
              "reason": {"$ref": "../common.schema.json#/$defs/nonEmptyString"},
              "expires_at": {"$ref": "../common.schema.json#/$defs/dateTime"}
            }
          }
        }
      }
    }
  }
}
