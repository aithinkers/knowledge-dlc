{
  "name": "knowledge-dlc",
  "version": "1.0.0",
  "private": false,
  "description": "K-DLC (Knowledge Development Lifecycle): turn documents, wikis, emails, and Confluence/SharePoint/OneDrive/Google Drive sources into governed, provenance-bearing knowledge that AI agents can trust \u2014 with reviewed publication, conflict retention, and citation-exact retrieval. Works natively in Claude Code, Codex, Kiro, and any MCP client.",
  "license": "MIT",
  "author": "AIThinkers",
  "homepage": "https://github.com/aithinkers/knowledge-dlc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aithinkers/knowledge-dlc.git"
  },
  "bugs": {
    "url": "https://github.com/aithinkers/knowledge-dlc/issues"
  },
  "keywords": [
    "knowledge-management",
    "knowledge-base",
    "rag",
    "ai-agents",
    "mcp",
    "mcp-server",
    "provenance",
    "governance",
    "lifecycle",
    "document-ingestion",
    "confluence",
    "sharepoint",
    "onedrive",
    "google-drive",
    "claude-code",
    "llm",
    "retrieval",
    "open-knowledge-format"
  ],
  "files": [
    "core/",
    "distribution/",
    "packages/",
    "workers/",
    "security/npm-package-files.json",
    "docs/supply-chain/sbom.spdx.json",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    "./normalizers": "./packages/normalizers/index.mjs",
    "./extensions": "./packages/extensions/index.mjs",
    "./cli": "./packages/cli/index.mjs",
    "./mcp": "./packages/mcp/index.mjs",
    "./erasure": "./packages/erasure/index.mjs",
    "./adapters": "./packages/adapters/index.mjs"
  },
  "bin": {
    "kdlc": "./packages/cli/bin.mjs",
    "knowledge-dlc": "./packages/cli/bin.mjs"
  },
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": ">=22.23.2 <25",
    "npm": ">=10.9.8 <12"
  },
  "scripts": {
    "check:governance": "node scripts/verify-governance.mjs",
    "check:supply-chain": "node scripts/verify-supply-chain.mjs",
    "check:release-evidence": "node scripts/verify-release-evidence.mjs",
    "check:statistical-evidence": "node scripts/verify-statistical-evidence.mjs",
    "test:release-evaluation": "node scripts/run-release-evaluation.mjs",
    "sbom:generate": "node scripts/verify-supply-chain.mjs --write",
    "test:extensions": "node --test tests/governance/extensions.test.mjs",
    "test:governance": "node --test tests/governance/*.test.mjs",
    "generate:distribution": "node packages/adapters/generate.mjs",
    "check:distribution": "node packages/adapters/generate.mjs --check",
    "test": "npm run check:governance && npm run test:governance"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "4.0.0",
    "csv-parse": "7.0.2",
    "fflate": "0.8.3",
    "gifuct-js": "2.1.2",
    "pdfjs-dist": "6.2.108",
    "saxes": "6.0.0",
    "semver": "7.8.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
