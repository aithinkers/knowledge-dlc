{
  "name": "knowledge-dlc",
  "version": "0.0.0-private",
  "private": true,
  "description": "K-DLC development and governance tooling",
  "type": "module",
  "exports": {
    "./normalizers": "./packages/normalizers/index.mjs",
    "./extensions": "./packages/extensions/index.mjs",
    "./cli": "./packages/cli/index.mjs",
    "./mcp": "./packages/mcp/index.mjs",
    "./adapters": "./packages/adapters/index.mjs"
  },
  "bin": {"kdlc": "./packages/cli/bin.mjs"},
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": ">=22.23.2 <25",
    "npm": ">=10.9.8 <12"
  },
  "scripts": {
    "check:governance": "node scripts/verify-governance.mjs",
    "test:extensions": "node --test tests/governance/extensions.test.mjs",
    "test:governance": "node --test tests/governance/*.test.mjs",
    "generate:distribution": "node packages/adapters/generate.mjs",
    "check:distribution": "node packages/adapters/generate.mjs --check",
    "test": "npm run check:governance && npm run check:distribution && npm run test:governance"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "4.0.0",
    "csv-parse": "7.0.2",
    "fflate": "0.8.3",
    "gifuct-js": "2.1.2",
    "pdfjs-dist": "6.2.108",
    "saxes": "6.0.0",
    "semver": "7.7.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
